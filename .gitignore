.superpowers/
__pycache__/
*.pyc
# réglages propres à la machine et au projet observé (jamais publiés)
*.local.json
.factory/
node_modules/

# configuration locale de prévisualisation (chemins de la machine)
.claude/launch.json

# fichiers produits par le serveur quand on lance la démo
exemples/demo/equipe.json
exemples/demo/charge-historique.jsonl
exemples/demo/usage-historique.jsonl
exemples/demo/prix-historique.jsonl
exemples/demo/alertes-historique.jsonl
*.jsonl.tmp

# fichiers produits quand on lance la démo ou le projet neuf sur place
exemples/*/images/pieces/
exemples/demo-b/equipe.json
exemples/demo-b/*-historique.jsonl
exemples/projet-neuf/suivi.json
exemples/projet-neuf/suivi.json.verrou
exemples/projet-neuf/demandes.jsonl
exemples/projet-neuf/sessions.json
exemples/projet-neuf/pieces/
exemples/projet-neuf/equipe.json
exemples/projet-neuf/*-historique.jsonl
